{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "calendar.swisslock.net" }],
      "destination": "/artifacts/kalender.html",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/q/:slug", "destination": "/api/q?slug=:slug" }
  ],
  "headers": [
    {
      "source": "/artifacts/kalender(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/scan.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/ping", "schedule": "23 4 * * *" }
  ],
  "regions": ["dub1"]
}
